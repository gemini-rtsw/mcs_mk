#
# pvload parameter file for the MCS (Stage)
#

long $(top)simLevelL        = "0";    # Initial value for simulate level.
long $(top)debugLevelL      = "0";    # Initial value for debug level.
long $(top)FollowL          = "0";    # Set follow status to "IGNORING".
long $(top)azDatumL         = "0";    # Set Azimuth to "NOT DATUMED".
long $(top)elDatumL         = "1";    # Set Elevation to "DATUMED".
long $(top)state            = "2";    # Set state to "RUNNING".
long $(top)arrayS           = "0";    # Set status of 20Hz data to "VALID".
long $(top)azVEalgorithmL   = "0";    # Set Azimuth VE algorithm to "FDE".
long $(top)azVEheadsL       = "0";    # Set Azimuth VE heads to "NONE".
long $(top)elVEalgorithmL   = "0";    # Set Elevation VE algorithm to "FDE".
long $(top)elVEheadsL       = "0";    # Set Elevation VE heads to "NONE".
long $(top)logDataL         = "0";    # Set initial value for PMAC logging to "OFF".

string $(top)health         = "GOOD";                        # Set health to "GOOD".
string $(top)azpmacSir      = " ";                           # Init. as a blank string.
string $(top)savePath       = "/gemini/mcs/mcs";             # Pathname to save dir.

#double $(top)memoryScanRate = "10.0";    # Memory statistics obtained every <nn> seconds.
#double $(top)loadScanRate   = "5.0";     # CPU load calculated every <nn> seconds.
double $(top)cpuScanPeriod   = "5.0";     # CPU load calculated every <nn> seconds.
double $(top)azCurrentPos   = "0.0";     # Start position of azimuth axis.
double $(top)azCurrentVel   = "0.0";     # Start velocity of azimuth axis.
double $(top)azPosError     = "0.0";     # Start error of azimuth axis.
double $(top)elCurrentPos   = "45.0";    # Start position of elevation axis.
double $(top)elCurrentVel   = "0.0";     # Start velocity of elevation axis.
double $(top)elPosError     = "0.0";     # Start error of elevation axis.
double $(top)positionTol    = "4.16e-6"; # Position Tolerance.
double $(top)velocityTol    = "4.16e-6"; # Position Tolerance.
double $(top)azPark         = "90.0";    # Azimuth Park Position.
double $(top)elPark         = "90.0";    # Elevation Park Position.
double $(top)cwUpperLimit   = "970.0";   # Upper Limit for Counterweight moves.
double $(top)cwLowerLimit   = "0.0";     # Lower Limit for Counterweight moves.

# Run the "TESTLAN" Command

long $(top)testLan.DIR      = "0";        # Mark the CAD Record
long $(top)testLan.DIR      = "3";        # Start the CAD Record

# PMAC Commands not used at initialisation

string $(top)PmacCmd_Gather     = "GATHER";    # Start PMAC logging
string $(top)PmacCmd_CloseLoop2 = "#2J/";      # Close the loop for motor 2
string $(top)PmacCmd_Abort      = "&2A";       # Abort Motion Program for Coordinate System 2
string $(top)PmacCmd_CSPoint    = "&2B1";      # Point to beginning of Motion Program 1 (CS 2)
string $(top)PmacCmd_Run        = "&2R";           # Run Motion Program (CS 2)
string $(top)PmacCmd_M150       = "M150=1";        # Set Motion Program handshake bit
string $(top)PmacCmd_FFE_OFF    = "I211=0";        # Turn off Fatal Following Error
string $(top)PmacCmd_FFE_ON     = "I211=41668";    # Turn on  Fatal Following Error (5 deg)
string $(top)PmacCmd_Kill2      = "#2K";           # Kill motor 2

# These PMAC Commands are sent, in this order, at initialisation of database
# for the Azimuth and Elevation cards.

string $(top)PmacCmd_I49        = "I49=1";        # Switch on Background Fixed Data Buffer
string $(top)PmacCmd_I55        = "I55=1";        # Switch on Background Variable Data Buffer
string $(top)PmacCmd_I59        = "I59=2";        # Number of Motors to be reported
string $(top)PmacCmd_I100       = "I100=1";       # Enabled Motor 1
string $(top)PmacCmd_I159       = "I159=1";       # Enable Motor 1 user-written servo
# Be careful, this crashes PMAC if the user-written servo code is not running.
string $(top)PmacCmd_CloseLoop1 = "#1J/";         # Close the loop for motor 1
string $(top)PmacCmd_M1         = "M1=1";         # Set the data logging time trigger
string $(top)PmacCmd_Endgather  = "ENDGATHER";    # Stop PMAC logging
string $(top)PmacCmd_I45        = "I45=3";        # Gathering buffer in DPRAM with wraparound
string $(top)PmacCmd_I21        = "I21=$400000";  # Always collect the servo counter
string $(top)PmacCmd_P101       = "P101=5";       # Motion Program - Segment interval (ms)
string $(top)PmacCmd_P102       = "P102=1";       # Motion Program - Loop Enable Flag
string $(top)PmacCmd_MPscale    = "&2#2->520X";   # Set scaling for Motion Program
string $(top)PmacCmd_I206       = "I206=0";       # Disable Handwheel
string $(top)PmacCmd_DefineM150 = "M150->F:$DFFE"; # Define M150 memory location
string $(top)PmacCmd_ReadSC     = "M0";           # Read the servo counter

# Causes the above commands to be sent to Azimuth PMAC.
long   $(top)azPMAC_I49S.PROC   = "1";         # Download az PMAC Commands at initialisation (az)

# Causes the above commands to be sent to Elevation PMAC.
long   $(top)elPMAC_I49S.PROC   = "1";         # Download el PMAC Commands at initialisation (el)

# These commands replace those which are similar above for the Counterweights PMAC.
string $(top)PmacCmd_I800       = "I800=1";    # Enable Motor 8 (for cw)
string $(top)PmacCmd_I859       = "I859=1";    # Enable Motor 8 user-written servo (for cw)
string $(top)PmacCmd_CloseLoop8 = "#8J/";      # Close the loop for motor 8 (for cw)

# Causes the above commands to be sent to the Counterweights PMAC.
#long   $(top)cwPMAC_I49S.PROC   = "1";

# Prevents the logData CAD from rejecting the command when no time reference is available
# (i.e. if the PMAC->Bancomm wire is disconnected)
# Note: If there is only 1 PMAC card in the crate, it always corresponds to Az.
#       If there are two, they are Az and El. This is regardless of the fact that
#       card number 0 = Az, card number 1 = El. Due to sequence in which PMAC cards
#       trigger latching of the time signal on Bancomm (Az, El, Cw).
#double  $(top)logDataazTime      = "10.0";
#double  $(top)logDataelTime      = "11.0";
double  $(top)logDatacwTime      = "12.0";

# Switch on trace processing of the external event Bancomm record (latches time reference for
# logging).
#long $(top)bancommExtEvent.TPRO  = 1;

# The size of in-memory log buffer is important. Note "4.6" did not work!
#
double $(top)logDataazBufferSize  = "4.8";   # Size of Az. in-memory log buffer (Mbytes)
double $(top)logDataelBufferSize  = "0.05";  # Size of El. in-memory log buffer (Mbytes)
double $(top)logDatacwBufferSize  = "0.05";  # Size of Cw. in-memory log buffer (Mbytes)

# Dummy GIS
double $(top)azdummyGISseq.DLY1 = "1.0";        # Response time of dummy Az. GIS (sec)
double $(top)eldummyGISseq.DLY1 = "1.0";        # Response time of dummy El. GIS (sec)

# GIS Interface
double $(top)GIStimeout         = "2.0";                           # GIS timeout (sec)
double $(top)GISbypass          = "OFF";                           # Do not bypass
string $(top)azGISerrorString   = "Azimuth axis is interlocked";   # Error string
string $(top)elGISerrorString   = "Elevation axis is interlocked"; # Error string
string $(top)azDriveEnable      = "DISASSERTED";                   # Send DISASSERTED
string $(top)elDriveEnable      = "DISASSERTED";                   # Send DISASSERTED

# For the stage
double $(top)azMaxVel                = "4.5";   # Maximum az velocity (deg/sec).
double $(top)elMaxVel                = "4.5";   # Maximum el velocity (deg/sec).
double $(top)azMaxAccel              = "0.1";   # Maximum az acceleration (deg/s/s).
double $(top)elMaxAccel              = "0.1";   # Maximum el acceleration (deg/s/s).
double $(top)azCurrentMaxVel         = "4.5";   # Current maximum azimuth velocity (deg/sec).
double $(top)elCurrentMaxVel         = "4.5";   # Current maximum elevation velocity (deg/sec).
double $(top)azCountsPerDegree       = "16640"; # 3000000 VE cnts = 180.288 degrees
double $(top)elCountsPerDegree       = "16640"; # 3000000 VE cnts = 180.288 degrees
