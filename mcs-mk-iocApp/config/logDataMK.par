#
# pvload parameter file for logData menus and PMAC Addresses
#
# PMAC Addresses are specified as: <DATASET> <DATATYPE>:$<ADDRESS>
# where <DATASET> is a 4-bit binary representation of which datasets, this
# data item is a member of.
#
# Thus:
#	0 => Not in any dataset.
#	1 => In Dataset 1.
#	2 => In Dataset 2.
#	3 => In Datasets 1 and 2.
#	4 => In Dataset 3.
#	5 => In Datasets 1 and 3.
#	6 => In Datasets 2 and 3.
#	7 => In Datasets 1 and 2 and 3.
#       8 => In Dataset 4.
#       9 => In Datasets 1 and 4.
#      10 => In Datasets 2 and 4.
#      11 => In Datasets 1 and 2 and 4.
#      12 => In Datasets 3 and 4.
#      13 => In Datasets 1 and 3 and 4.
#      14 => In Datasets 2 and 3 and 4.
#      15 => In Datasets 1 and 2 and 3 and 4.
#

#
# Azimuth PMAC Card
# Data Logging menus and addresses
# Azimuth Axis is controlled from PMAC motor 2
#

# Az Menu Entry 0 and address
string $(top)azMenuEntry0 = "NONE";
string $(top)azPmacAddr0  = "0 X:$0000";

# Az Menu Entry 1 and address
string $(top)azMenuEntry1 = "X-$1201";
string $(top)azPmacAddr1  = "1 X:$1201";

# Az Menu Entry 2 and address
string $(top)azMenuEntry2 = "D-$00A3";
string $(top)azPmacAddr2  = "1 D:$00A3";

# Az Menu Entry 3 and address
string $(top)azMenuEntry3 = "D-$1304";
string $(top)azPmacAddr3  = "1 D:$1304";

# Az Menu Entry 4 and address
string $(top)azMenuEntry4 = "X-$1200";
string $(top)azPmacAddr4  = "1 X:$1200";

# Az Menu Entry 5 and address
string $(top)azMenuEntry5 = "X-$0723";
string $(top)azPmacAddr5  = "1 X:$0723";

# Az Menu Entry 6 and address
string $(top)azMenuEntry6 = "D-$1303";
string $(top)azPmacAddr6  = "1 D:$1303";

# Az Menu Entry 7 and address
string $(top)azMenuEntry7 = "D-$0067";
string $(top)azPmacAddr7  = "1 D:$0067";

# Az Menu Entry 8 and address
string $(top)azMenuEntry8 = "D-$0064";
string $(top)azPmacAddr8  = "4 D:$0064";

# Az Menu Entry 9 and address
string $(top)azMenuEntry9 = "M68";
string $(top)azPmacAddr9  = "4 F:$DF08";

# Az Menu Entry 10 and address
string $(top)azMenuEntry10 = "M69";
string $(top)azPmacAddr10  = "4 F:$DF09";

# Az Menu Entry 11 and address
string $(top)azMenuEntry11 = "M70";
string $(top)azPmacAddr11  = "4 F:$DF0A";

# Az Menu Entry 12 and address
string $(top)azMenuEntry12 = "M71";
string $(top)azPmacAddr12  = "4 F:$DF0B";

# Az Menu Entry 13 and address
string $(top)azMenuEntry13 = "M72";
string $(top)azPmacAddr13  = "4 F:$DF0C";

# Az Menu Entry 14 and address
string $(top)azMenuEntry14 = "M73";
string $(top)azPmacAddr14  = "4 F:$DF0D";

# Az Menu Entry 15 and address
string $(top)azMenuEntry15 = "M74";
string $(top)azPmacAddr15  = "4 F:$DF0E";

#
# Elevation PMAC Card
